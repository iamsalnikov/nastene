HTTP_ADDR=:8080
DATABASE_URL=postgres://nastene:nastene@localhost:5432/nastene?sslmode=disable
SESSION_COOKIE_NAME=nastene_sid
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false

# Публичный URL (для построения invite-ссылок). Опционально.
PUBLIC_URL=http://localhost:8080

# Система инвайтов
INVITES_PER_USER=2
REGISTRATION_MODE=invite  # invite | open

# S3-совместимое хранилище. Локально (compose) — MinIO, в проде — любой S3.
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nastene-dev
S3_USE_SSL=false
S3_PRESIGN_TTL=1h
S3_AUTO_CREATE_BUCKET=true

# Prod-only (используются только в prod/docker-compose.yml и prod/Caddyfile)
POSTGRES_PASSWORD=nastene
DOMAIN=example.com
