HTTP_ADDR=:8080
DATABASE_URL=postgres://nastene:nastene@localhost:5432/nastene?sslmode=disable
SESSION_COOKIE_NAME=nastene_sid
SESSION_TTL=720h
SESSION_COOKIE_SECURE=false

# Система инвайтов
INVITES_PER_USER=2
REGISTRATION_MODE=invite  # invite | open

# S3-совместимое хранилище. Локально (compose) — MinIO, в проде — любой S3.
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=nastene-dev
S3_USE_SSL=false
S3_PRESIGN_TTL=1h
S3_AUTO_CREATE_BUCKET=true

# Транспорт событий (новостная лента, баны, приватность). Локально compose
# поднимает контейнер "rabbit". Бинарь cmd/feed-builder подключается как subscriber,
# cmd/nastene — как publisher.
RABBITMQ_DSN=amqp://guest:guest@localhost:5672/
CONSUMER_GROUP=nastene

# Prod-only (используются только в prod/docker-compose.yml)
POSTGRES_PASSWORD=nastene
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
