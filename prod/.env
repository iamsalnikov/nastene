HTTP_ADDR=:8080
DATABASE_URL=postgres://nastene:${POSTGRES_PASSWORD}@postgres:5432/nastene?sslmode=disable
SESSION_COOKIE_NAME=nastene_sid
SESSION_TTL=720h
SESSION_COOKIE_SECURE=true
PUBLIC_URL=https://nastene.live
INVITES_PER_USER=2
REGISTRATION_MODE=open

S3_ENDPOINT=fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY} 
S3_BUCKET=${S3_BUCKET}
S3_USE_SSL=true
S3_PRESIGN_TTL=1h
S3_AUTO_CREATE_BUCKET=false

POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DOMAIN=nastene.live
